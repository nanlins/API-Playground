# LLM API Playground - Environment Variables
# Copy to .env and fill in your keys.

# DeepSeek
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODELS=deepseek-v4-flash,deepseek-v4-pro

# Dashscope / Qwen (Embedding also uses Dashscope)
DASHSCOPE_API_KEY=sk-your-dashscope-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODELS=qwen-plus,qwen-max,qwen-turbo
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v2

# Server
HOST=0.0.0.0
PORT=8000

# 修改记录：2026-09-30 DEEPSEEK_BASE_URL 改为官方端点 https://api.deepseek.com/v1
